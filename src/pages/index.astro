---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import heroImg from "../assets/hero.png";
import heroDarkImg from "../assets/hero-dark.png";
import {
  site, approach, expertise, experience, education, credentials, research, practices,
} from "../data/site";

const formAction = site.formspreeId
  ? `https://formspree.io/f/${site.formspreeId}`
  : `mailto:${site.email}`;
const year = new Date().getFullYear();
const pad = (n: number) => String(n + 1).padStart(2, "0");
// Split a string into letters for the staggered hero animation.
const letters = (text: string, offset: number) =>
  [...text].map((ch, i) => ({ ch: ch === " " ? "\u00A0" : ch, i: i + offset }));
const nav = [
  ["Home", "#top"],
  ["About", "#about"],
  ["Approach", "#approach"],
  ["Expertise", "#expertise"],
  ["Experience", "#experience"],
  ["Contact", "#contact"],
];
---

<Base>
  <header class="site-header">
    <div class="wrap">
      <a href="#top" class="brand" aria-label={`${site.name}, home`}><span class="mono">{site.initials}</span></a>
      <nav class="nav" id="nav">
        {nav.map(([label, href], i) => <a href={href} class={i === 0 ? "active" : ""}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <button class="icon-btn theme-btn" id="theme-btn" type="button" aria-label="Switch to dark mode">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a class="btn btn-primary btn-sm header-cta" href={site.contactUrl}>Get in touch</a>
        <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- Hero: portrait as the centrepiece, giant name behind it -->
    <section class="hero">
      <div class="hero-stage">
        <svg class="hero-ecg" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
          <g class="ecg-track"><path d="M0 70 H60 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H300 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H540 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H780 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H1020 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H1260 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H1500 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H1740 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H1980 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H2220 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H2460 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H2700 l14 -8 l12 8 h22 l9 12 l15 -72 l15 90 l11 -30 h12 l22 -14 l22 14 H2880" /></g>
        </svg>
        <h1 class="hero-name" aria-label={site.name}>
          <span class="l1" aria-hidden="true">{letters(site.firstLine, 0).map((c) => <span class="ch" style={`--i:${c.i}`}>{c.ch}</span>)}</span>
          <span class="l2" aria-hidden="true">{letters(site.secondLine, site.firstLine.length).map((c) => <span class="ch" style={`--i:${c.i}`}>{c.ch}</span>)}</span>
        </h1>
        <div class="hero-portrait">
          <Image
            class="portrait-light"
            src={heroImg}
            alt={`Portrait of ${site.name}`}
            widths={[480, 640, 803]}
            sizes="(max-width: 760px) 92vw, 46vw"
            format="webp"
            quality={95}
            loading="eager"
            fetchpriority="high"
          />
          <Image
            class="portrait-dark"
            src={heroDarkImg}
            alt=""
            aria-hidden="true"
            widths={[480, 640, 803]}
            sizes="(max-width: 760px) 92vw, 46vw"
            format="webp"
            quality={95}
            loading="eager"
          />
        </div>
        <div class="hero-intro">
          {!site.acceptingAppointments && (
            <p class="status-pill"><span class="dot" aria-hidden="true"></span>{site.statusShort}</p>
          )}
          <p class="eyebrow">{site.role}</p>
          <p class="hero-line">{site.heroLine}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={site.contactUrl}>Get in touch <span class="arrow">→</span></a>
            <a class="btn btn-outline" href="#expertise">View expertise <span class="arrow">→</span></a>
          </div>
        </div>
        <dl class="hero-facts">
          <div style="--d:0"><dt>Experience</dt><dd>{site.yearsExperience} years</dd></div>
          <div style="--d:1"><dt>Qualifications</dt><dd>{site.qualifications}</dd></div>
          <div style="--d:2"><dt>Based in</dt><dd>{site.location}</dd></div>
        </dl>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="alt">
      <div class="wrap split reveal">
        <div>
          <p class="eyebrow">About me</p>
          <h2>{site.aboutHeading}</h2>
        </div>
        <div>
          <p class="about-text">{site.about}</p>
          <ul class="creds">
            {credentials.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Approach -->
    <section id="approach">
      <div class="wrap">
        <div class="reveal">
          <p class="eyebrow">How I work</p>
          <h2>Care approach</h2>
        </div>
        <div class="approach-grid">
          <div class="approach-photo reveal">
            {site.approachPhoto
              ? <img src={site.approachPhoto} alt={`${site.name} at work`} />
              : <div class="photo-placeholder"><strong>{site.initials}</strong>Second photo here</div>}
          </div>
          <div class="stack">
            {approach.map((a) => (
              <div class="stack-card reveal">
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Expertise -->
    <section id="expertise" class="alt">
      <div class="wrap">
        <div class="reveal">
          <p class="eyebrow">Areas of expertise</p>
          <h2>How I can help</h2>
        </div>
        <div class="grid-3">
          {expertise.map((e, i) => (
            <div class="cell reveal">
              <span class="num">{pad(i)}</span>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience">
      <div class="wrap">
        <div class="reveal">
          <p class="eyebrow">Background</p>
          <h2>Experience and training</h2>
        </div>
        <div class="split" style="margin-top:56px">
          <div class="rows reveal">
            <h3>EXPERIENCE</h3>
            {experience.map((e) => (
              <div class="row"><span class="yr">{e.years}</span><div><strong>{e.role}</strong><span>{e.place}</span></div></div>
            ))}
          </div>
          <div class="rows reveal">
            <h3>EDUCATION</h3>
            {education.map((e) => (
              <div class="row"><span class="yr">{e.years}</span><div><strong>{e.degree}</strong><span>{e.place}</span></div></div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Research & talks -->
    {research.length > 0 && (
      <section id="research" class="alt">
        <div class="wrap split">
          <div class="reveal">
            <p class="eyebrow">Research and talks</p>
            <h2>Selected work</h2>
          </div>
          <div class="rows reveal">
            {research.map((r) => (
              <div class="row">
                <span class="yr">{r.year}</span>
                <a href={r.url}><strong>{r.title}</strong><span>{r.venue}</span></a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Contact -->
    <section id="contact">
      <div class="wrap">
        <div class="reveal">
          <p class="eyebrow">Contact</p>
          <h2>Get in touch</h2>
          {!site.acceptingAppointments && (
            <p class="status-note"><span class="dot" aria-hidden="true"></span>{site.statusLong}</p>
          )}
        </div>
        <div class="contact-grid">
          <div class="info-list reveal">
            {site.acceptingAppointments && practices.map((p) => (
              <div><small>CLINIC</small><p>{p.name}</p><span>{p.address}</span></div>
              <div><small>HOURS</small><p>{p.hours}</p></div>
            ))}
            <div><small>EMAIL</small><p><a href={`mailto:${site.email}`}>{site.email}</a></p></div>
            <div><small>PHONE</small><p>{site.phone}</p></div>
          </div>
          <form action={formAction} method="POST" class="reveal">
            <label>NAME<input name="name" required autocomplete="name" /></label>
            <label>EMAIL<input type="email" name="email" required autocomplete="email" /></label>
            <label>MESSAGE<textarea name="message" rows="4" required></textarea></label>
            <p class="note">Please don't share personal medical details here. This form isn't for emergencies: if you need urgent help, call 112 or go to your nearest emergency department.</p>
            <button type="submit" class="btn btn-primary">Send message <span class="arrow">→</span></button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <div class="foot-top">
        <a href="#top" class="brand" aria-label={`${site.name}, home`}><span class="mono">{site.initials}</span></a>
        <div class="foot-links">
          {site.socials.map((s) => <a href={s.url}>{s.label}</a>)}
          <a href={`mailto:${site.email}`}>Email</a>
        </div>
      </div>
      <p class="disclaimer">The information on this website is for general information only and isn't a substitute for professional medical advice, diagnosis or treatment.</p>
      <p class="copy">© {year} {site.name}. All rights reserved.</p>
    </div>
  </footer>

  <script>
    // Theme toggle
    const root = document.documentElement;
    const themeBtn = document.getElementById("theme-btn");
    const syncThemeLabel = () => {
      const dark = root.getAttribute("data-theme") === "dark";
      themeBtn?.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
    };
    syncThemeLabel();
    themeBtn?.addEventListener("click", () => {
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem("theme", next); } catch (e) {}
      syncThemeLabel();
    });

    // Mobile menu
    const btn = document.getElementById("menu-btn");
    const nav = document.getElementById("nav");
    btn?.addEventListener("click", () => {
      const open = nav?.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(open));
    });
    nav?.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        nav.classList.remove("open");
        btn?.setAttribute("aria-expanded", "false");
      })
    );

    // Highlight current section in nav
    const links = [...(nav?.querySelectorAll("a") ?? [])];
    const targets = links
      .map((a) => ({ a, el: document.querySelector(a.getAttribute("href") || "") }))
      .filter((t) => t.el && t.el.id !== "top") as { a: Element; el: Element }[];
    const setActive = () => {
      const line = window.innerHeight * 0.4;
      let current = links[0];
      targets.forEach((t) => { if (t.el.getBoundingClientRect().top <= line) current = t.a; });
      links.forEach((a) => a.classList.toggle("active", a === current));
    };
    window.addEventListener("scroll", setActive, { passive: true });
    setActive();

    // Hero depth: name and portrait drift at different speeds while scrolling
    const hero = document.querySelector<HTMLElement>(".hero");
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (hero && !calm.matches) {
      let ticking = false;
      const update = () => {
        const y = Math.min(window.scrollY, window.innerHeight);
        hero.style.setProperty("--sy", String(y));
        ticking = false;
      };
      window.addEventListener("scroll", () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();

      // Mouse depth (desktop only): layers shift in opposite directions
      if (window.matchMedia("(pointer: fine)").matches) {
        hero.addEventListener("pointermove", (e) => {
          const r = hero.getBoundingClientRect();
          hero.style.setProperty("--mx", (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
          hero.style.setProperty("--my", (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
        });
        hero.addEventListener("pointerleave", () => {
          hero.style.setProperty("--mx", "0");
          hero.style.setProperty("--my", "0");
        });
      }
    }

    // Fade-in on scroll
    const revealObs = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("in"); revealObs.unobserve(e.target); }
      }),
      { threshold: 0.12 }
    );
    document.querySelectorAll(".reveal").forEach((el) => revealObs.observe(el));
  </script>
</Base>
