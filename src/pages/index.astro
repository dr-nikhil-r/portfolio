---
import Base from "../layouts/Base.astro";
import {
  site, approach, expertise, experience, education, credentials, research, practices,
} from "../data/site";

const formAction = site.formspreeId
  ? `https://formspree.io/f/${site.formspreeId}`
  : `mailto:${site.email}`;
const year = new Date().getFullYear();
const pad = (n: number) => String(n + 1).padStart(2, "0");
const nav = [
  ["Home", "#top"],
  ["About", "#about"],
  ["Approach", "#approach"],
  ["Expertise", "#expertise"],
  ["Experience", "#experience"],
  ["Contact", "#contact"],
];
---

<Base>
  <header class="site-header">
    <div class="wrap">
      <a href="#top" class="brand">{site.brand}</a>
      <nav class="nav" id="nav">
        {nav.map(([label, href], i) => <a href={href} class={i === 0 ? "active" : ""}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <button class="icon-btn theme-btn" id="theme-btn" type="button" aria-label="Switch to dark mode">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a class="btn btn-primary btn-sm header-cta" href={site.bookingUrl}>Book a consultation</a>
        <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- Hero -->
    <section class="hero">
      <div class="wrap">
        <div class="hero-grid">
          <div class="hero-text">
            <p class="eyebrow">{site.role}</p>
            <h1><span>{site.firstLine}</span><span>{site.secondLine}</span></h1>
            <p class="hero-line">{site.heroLine}</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={site.bookingUrl}>Book a consultation <span class="arrow">→</span></a>
              <a class="btn btn-outline" href="#expertise">View expertise <span class="arrow">→</span></a>
            </div>
          </div>
          <div class="hero-photo">
            {site.heroPhoto
              ? <img src={site.heroPhoto} alt={`Portrait of ${site.name}`} />
              : <div class="photo-placeholder"><strong>{site.initials}</strong>Your photo here</div>}
          </div>
        </div>
        <div class="hero-meta">
          <div><strong>{site.yearsExperience}</strong><span>Years of experience</span></div>
          <div><strong>{site.qualifications}</strong><span>Qualifications</span></div>
          <div><strong>{site.location}</strong><span>Location</span></div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="alt">
      <div class="wrap split reveal">
        <div>
          <p class="eyebrow">About me</p>
          <h2>{site.aboutHeading}</h2>
        </div>
        <div>
          <p class="about-text">{site.about}</p>
          <ul class="creds">
            {credentials.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Approach -->
    <section id="approach">
      <div class="wrap">
        <div class="reveal">
          <p class="eyebrow">How I work</p>
          <h2>Care approach</h2>
        </div>
        <div class="approach-grid">
          <div class="approach-photo reveal">
            {site.approachPhoto
              ? <img src={site.approachPhoto} alt={`${site.name} at work`} />
              : <div class="photo-placeholder"><strong>{site.initials}</strong>Second photo here</div>}
          </div>
          <div class="stack">
            {approach.map((a) => (
              <div class="stack-card reveal">
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Expertise -->
    <section id="expertise" class="alt">
      <div class="wrap">
        <div class="reveal">
          <p class="eyebrow">Areas of expertise</p>
          <h2>How I can help</h2>
        </div>
        <div class="grid-3">
          {expertise.map((e, i) => (
            <div class="cell reveal">
              <span class="num">{pad(i)}</span>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience">
      <div class="wrap">
        <div class="reveal">
          <p class="eyebrow">Background</p>
          <h2>Experience and training</h2>
        </div>
        <div class="split" style="margin-top:56px">
          <div class="rows reveal">
            <h3>EXPERIENCE</h3>
            {experience.map((e) => (
              <div class="row"><span class="yr">{e.years}</span><div><strong>{e.role}</strong><span>{e.place}</span></div></div>
            ))}
          </div>
          <div class="rows reveal">
            <h3>EDUCATION</h3>
            {education.map((e) => (
              <div class="row"><span class="yr">{e.years}</span><div><strong>{e.degree}</strong><span>{e.place}</span></div></div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Research & talks -->
    {research.length > 0 && (
      <section id="research" class="alt">
        <div class="wrap split">
          <div class="reveal">
            <p class="eyebrow">Research and talks</p>
            <h2>Selected work</h2>
          </div>
          <div class="rows reveal">
            {research.map((r) => (
              <div class="row">
                <span class="yr">{r.year}</span>
                <a href={r.url}><strong>{r.title}</strong><span>{r.venue}</span></a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Contact -->
    <section id="contact">
      <div class="wrap">
        <div class="reveal">
          <p class="eyebrow">Get in touch</p>
          <h2>Book a consultation</h2>
        </div>
        <div class="contact-grid">
          <div class="info-list reveal">
            {practices.map((p) => (
              <div><small>CLINIC</small><p>{p.name}</p><span>{p.address}</span></div>
              <div><small>HOURS</small><p>{p.hours}</p></div>
            ))}
            <div><small>EMAIL</small><p><a href={`mailto:${site.email}`}>{site.email}</a></p></div>
            <div><small>PHONE</small><p>{site.phone}</p></div>
          </div>
          <form action={formAction} method="POST" class="reveal">
            <label>NAME<input name="name" required autocomplete="name" /></label>
            <label>EMAIL<input type="email" name="email" required autocomplete="email" /></label>
            <label>MESSAGE<textarea name="message" rows="4" required></textarea></label>
            <p class="note">Please don't share personal medical details here. This form isn't for emergencies: if you need urgent help, call 112 or go to your nearest emergency department.</p>
            <button type="submit" class="btn btn-primary">Send message <span class="arrow">→</span></button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <div class="foot-top">
        <a href="#top" class="brand">{site.brand}</a>
        <div class="foot-links">
          {site.socials.map((s) => <a href={s.url}>{s.label}</a>)}
          <a href={`mailto:${site.email}`}>Email</a>
        </div>
      </div>
      <p class="disclaimer">The information on this website is for general information only and isn't a substitute for professional medical advice, diagnosis or treatment.</p>
      <p class="copy">© {year} {site.name}. All rights reserved.</p>
    </div>
  </footer>

  <script>
    // Theme toggle
    const root = document.documentElement;
    const themeBtn = document.getElementById("theme-btn");
    const syncThemeLabel = () => {
      const dark = root.getAttribute("data-theme") === "dark";
      themeBtn?.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
    };
    syncThemeLabel();
    themeBtn?.addEventListener("click", () => {
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem("theme", next); } catch (e) {}
      syncThemeLabel();
    });

    // Mobile menu
    const btn = document.getElementById("menu-btn");
    const nav = document.getElementById("nav");
    btn?.addEventListener("click", () => {
      const open = nav?.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(open));
    });
    nav?.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        nav.classList.remove("open");
        btn?.setAttribute("aria-expanded", "false");
      })
    );

    // Highlight current section in nav
    const links = [...(nav?.querySelectorAll("a") ?? [])];
    const targets = links
      .map((a) => ({ a, el: document.querySelector(a.getAttribute("href") || "") }))
      .filter((t) => t.el && t.el.id !== "top") as { a: Element; el: Element }[];
    const setActive = () => {
      const line = window.innerHeight * 0.4;
      let current = links[0];
      targets.forEach((t) => { if (t.el.getBoundingClientRect().top <= line) current = t.a; });
      links.forEach((a) => a.classList.toggle("active", a === current));
    };
    window.addEventListener("scroll", setActive, { passive: true });
    setActive();

    // Fade-in on scroll
    const revealObs = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("in"); revealObs.unobserve(e.target); }
      }),
      { threshold: 0.12 }
    );
    document.querySelectorAll(".reveal").forEach((el) => revealObs.observe(el));
  </script>
</Base>
